{
  "expo": {
    "name": "SpotFinder",
    "slug": "spotfinder",
    "scheme": "exp+spotfinder",
    "plugins": [
      "expo-location",
      "expo-notifications",
      "@maplibre/maplibre-react-native"
    ],
    "android": {
      "package": "com.sawzw.spotfinder",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "c182291f-48a0-4455-9345-83c7240b9ef1"
      }
    }
  }
}
